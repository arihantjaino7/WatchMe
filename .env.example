# Copy to apps/web/.env.local for local development. Never commit real values.

# Supabase (created in M0-E2; from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers (used from M3 onward)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides for lib/llm (default: gemini-2.0-flash for both tasks).
# LLM_REFLECT_MODEL=
# LLM_INTERPRET_MODEL=

# Inngest (used from M3 onward)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
